/// Validates this `{{ class_name }}`.
///
/// Usage:
/// ```dart
/// final result = value.validate();
/// if (result case Invalid(:final errors)) {
///   print(errors.first.message);
/// }
/// ```
{{ runtime.ValidationResult }} validate() {
{%- if not generic or fields %}
  final {{ self_name }} = this as {{ class_type }};
{%- endif %}
  final {{ errors_name }} = <{{ runtime.ValidationError }}>[];
{%- for field in fields %}
  {{ extension_name }}.{{ field.helper_name }}{{ field.type_arguments }}({% if field.uses_self %}{{ self_name }}, {% endif %}{{ self_name }}.{{ field.name }}, {{ errors_name }});
{%- endfor %}
  return {{ errors_name }}.isEmpty ? const {{ runtime.Valid }}() : {{ runtime.Invalid }}({{ errors_name }});
}

/// Throws [ValidationException] when this `{{ class_name }}` is invalid.
///
/// Usage:
/// ```dart
/// value.validateOrThrow();
/// ```
void validateOrThrow() {
  final {{ result_name }} = validate();
  if ({{ result_name }} case {{ runtime.Invalid }}({% if not generic or invalid_errors_name != "errors" %}errors: {% else %}:{% endif %}final {{ invalid_errors_name }})) {
    throw {{ runtime.ValidationException }}({{ invalid_errors_name }});
  }
}
