String testRouteLocation(TestRoute route) => route.location;

TestRoute parseTestRoute(Uri uri) {
  final segments = uri.pathSegments;

  if (segments.length == 1 && segments[0] == '404') {
    final route = NotFoundRoute(path: uri.queryParameters['path'] ?? '');
    return withGeneratedRouteUriExtras(route, uri, const {'path'});
  }
  if (segments.length == 1 && segments[0] == 'details') {
    final route = DetailsRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  if (segments.length == 1 && segments[0] == 'plain') {
    final route = PlainRoute();
    return withGeneratedRouteUriExtras(route, uri, const <String>{});
  }
  return _$notFoundRoute(uri);
}

TestRoute _$notFoundRoute(Uri uri) => NotFoundRoute(path: uri.toString());


