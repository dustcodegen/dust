#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

echo "==> Running Dust pre-commit checks"

run_without_git_env() {
  (
    unset $(git rev-parse --local-env-vars)
    "$@"
  )
}

ensure_generated_outputs_are_staged() {
  if ! git diff --quiet -- examples/product_showcase examples/benchmark_project examples/shopping_app examples/server_codegen fixtures/server_codegen_app; then
    echo "error: Dust generated proof outputs changed during pre-commit." >&2
    echo "Run: git add examples/product_showcase examples/benchmark_project examples/shopping_app examples/server_codegen fixtures/server_codegen_app" >&2
    echo "Then rerun your commit." >&2
    exit 1
  fi
}

# A fresh checkout has no package configuration for the Dart formatter yet.
run_without_git_env flutter pub get >/dev/null
run_without_git_env ./scripts/lint.sh
run_without_git_env ./scripts/security/audit.sh
python3 scripts/validate_compatibility_contract.py --self-test
python3 scripts/validate_compatibility_contract.py
ensure_generated_outputs_are_staged
run_without_git_env ./scripts/test.sh
./scripts/rust/coverage.sh 90
run_without_git_env ./scripts/dart/coverage.sh packages/dust_dart 100
run_without_git_env ./scripts/dart/coverage.sh packages/dust_db_sqlite3 96
run_without_git_env ./scripts/dart/coverage.sh packages/dust_server 100
run_without_git_env ./scripts/flutter/coverage.sh packages/dust_flutter 90
python3 scripts/check_lcov_floor.py \
  packages/dust_flutter/coverage/lcov.info 100 \
  --include-prefix lib/src/router/
python3 scripts/check_lcov_floor.py \
  packages/dust_flutter/coverage/lcov.info 100 \
  --include-prefix lib/src/state/
ensure_generated_outputs_are_staged

echo "==> Pre-commit checks passed"
