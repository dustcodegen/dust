import 'package:dust_dart/serde.dart';

part 'serde_scope.g.dart';

/// JSON object used by this consumer.
typedef Json = Map<String, Object?>;
typedef _DustSerdeObject = int;

/// Exercises a user declaration reserved against the generated alias.
int reservedNameProof(Object value) => value is _DustSerdeObject ? 1 : 0;

/// Legal source binders cannot capture generated runtime or local names.
@Derive([Serialize(), Deserialize()])
@SerDe(disallowUnrecognizedKeys: true)
class const Captured<
  String,
  Object,
  Map,
  Serializable,
  Serializer,
  Deserializer,
  JsonHelper,
  ArgumentError,
  instance,
  json,
  value,
  key,
  allowedKeys,
  amountValue,
  rawAmount,
  rawAmountKey
>(
  /// Concrete numeric value.
  @SerDe(aliases: ['old'], defaultValue: 0) final int amount,
) with
    _$Captured<
      String,
      Object,
      Map,
      Serializable,
      Serializer,
      Deserializer,
      JsonHelper,
      ArgumentError,
      instance,
      json,
      value,
      key,
      allowedKeys,
      amountValue,
      rawAmount,
      rawAmountKey
    > {
  /// Creates one JSON value.
  this;

  /// Decodes using the helper's inferred arguments.
  factory Captured.fromJson(Json data) => _$CapturedDeserialize(data);

  /// Decodes through the explicitly typed alias.
  factory Captured.alias(Json data) =>
      _$CapturedFromJson<
        String,
        Object,
        Map,
        Serializable,
        Serializer,
        Deserializer,
        JsonHelper,
        ArgumentError,
        instance,
        json,
        value,
        key,
        allowedKeys,
        amountValue,
        rawAmount,
        rawAmountKey
      >(data);

  /// Encodes through the explicitly typed alias.
  Json aliasJson() =>
      _$CapturedToJson<
        String,
        Object,
        Map,
        Serializable,
        Serializer,
        Deserializer,
        JsonHelper,
        ArgumentError,
        instance,
        json,
        value,
        key,
        allowedKeys,
        amountValue,
        rawAmount,
        rawAmountKey
      >(this);
}

/// Collection callbacks and core map entries have independent scopes.
@Derive([Serialize(), Deserialize()])
class const Collection<MapEntry, item, itemKey, value, valueKey, key>(
  /// Concrete nested entries.
  final Map<String, List<int>> entries,
) with _$Collection<MapEntry, item, itemKey, value, valueKey, key> {
  /// Creates one JSON value.
  this;

  /// Decodes using the helper's inferred arguments.
  factory Collection.fromJson(Json json) => _$CollectionDeserialize(json);

  /// Decodes through the explicitly typed alias.
  factory Collection.alias(Json json) =>
      _$CollectionFromJson<MapEntry, item, itemKey, value, valueKey, key>(json);

  /// Encodes through the explicitly typed alias.
  Json aliasJson() =>
      _$CollectionToJson<MapEntry, item, itemKey, value, valueKey, key>(this);
}

/// A binder named num must not capture a concrete numeric conversion.
@Derive([Serialize(), Deserialize()])
class const Decimal<num>(
  /// Concrete numeric value.
  /// Concrete numeric value.
  final double amount,
) with _$Decimal<num> {
  /// Creates one JSON value.
  this;

  /// Decodes using the helper's inferred arguments.
  factory Decimal.fromJson(Json json) => _$DecimalDeserialize(json);

  /// Decodes through the explicitly typed alias.
  factory Decimal.alias(Json json) => _$DecimalFromJson<num>(json);

  /// Encodes through the explicitly typed alias.
  Json aliasJson() => _$DecimalToJson<num>(this);
}
